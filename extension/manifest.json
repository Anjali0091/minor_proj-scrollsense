{
  "manifest_version": 3,
  "name": "ScrollSense Nudge Guard",
  "description": "Detects long scrolling streaks and applies nudges on distracting feeds.",
  "version": "1.0.0",
  "permissions": ["storage"],
  "host_permissions": [
    "http://localhost:5000/*",
    "https://youtube.com/*",
    "https://*.youtube.com/*",
    "https://x.com/*",
    "https://*.x.com/*",
    "https://instagram.com/*",
    "https://*.instagram.com/*",
    "https://reddit.com/*",
    "https://*.reddit.com/*",
    "https://facebook.com/*",
    "https://*.facebook.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://youtube.com/*",
        "https://*.youtube.com/*",
        "https://x.com/*",
        "https://*.x.com/*",
        "https://instagram.com/*",
        "https://*.instagram.com/*",
        "https://reddit.com/*",
        "https://*.reddit.com/*",
        "https://facebook.com/*",
        "https://*.facebook.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "ScrollSense"
  }
}
